# Copy to .env for `docker compose` (never commit .env).
POSTGRES_PASSWORD=change-me            # openssl rand -hex 24
SETUP_TOKEN=change-me                  # openssl rand -hex 24 — needed once at /setup?token=…
APP_ORIGIN=http://localhost:3000
AI_PROVIDER=codex-cli                  # codex-cli | claude-cli | mock
AI_CONCURRENCY=2
EASY_LEARN_PORT=3000                  # host port (localhost only)
