# Postgres connection string
DATABASE_URL=postgres://easylearn:easylearn@127.0.0.1:5433/easylearn
# Public origin of the app (used for Origin checks and cookies)
APP_ORIGIN=http://localhost:3000
# One-time token required by /setup to create the owner account (generate: openssl rand -hex 24)
SETUP_TOKEN=change-me
# Default AI provider: codex-cli | claude-cli | mock (can be changed in Settings)
AI_PROVIDER=codex-cli
# Max concurrent AI generation jobs
AI_CONCURRENCY=2
# Home directory used by the codex/claude CLIs (their sign-ins live here)
CLI_HOME=
# Encrypts stored API keys such as the OpenRouter key (openssl rand -hex 24)
APP_SECRET=
